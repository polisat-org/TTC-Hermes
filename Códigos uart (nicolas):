//esp32 receptor

#define RXp2 16
#define TXp2 17
#define LED 2

void setup() {
  Serial.begin(115200);
  
  // Inicializa a Serial2 nos pinos corretos do ESP32
  Serial2.begin(115200, SERIAL_8N1, RXp2, TXp2);
  
  pinMode(LED, OUTPUT);
  Serial.println("Receptor ESP32 Pronto...");
}

void loop() {
  // Verifica se há dados chegando na Serial2
if (Serial2.available() > 0) {
  String mensagem = Serial2.readStringUntil('\n'); // Lê até quebra de linha
  mensagem.trim();
  
  if (mensagem == "ON") { // Aspas duplas para String
    digitalWrite(LED, HIGH);
  }
  else if (mensagem == "OFF") {
    digitalWrite(LED, LOW);
  }
  Serial.println(mensagem);
}
}
}
