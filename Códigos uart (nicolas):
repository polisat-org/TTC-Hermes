//CÓDIGO ESCRITO NO ESP 32:
#define RXp2 16
#define TXp2 17
#define tempo 250
#define LED 4
String mensagem;

void setup() {
  Serial.begin(9600);
  Serial2.begin(9600, SERIAL_8N1, RXp2, TXp2);
  pinMode(LED, OUTPUT);
}

void loop() {
  if (Serial2.available() > 0) { // lê apenas se tiver algo
    mensagem = Serial2.readString();
    mensagem.trim();
    
    Serial.println(mensagem);
    
    if (mensagem == "1") { // mensagem de ativação do led é '1'
      digitalWrite(LED, HIGH);
    }
  }

  delay(tempo);
  digitalWrite(LED, LOW);
  delay(tempo);
}
