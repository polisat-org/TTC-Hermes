//CÓDIGO ESCRITO NO ESP 32:

#define RXp2 16
#define TXp2 17
#define tempo 250
#define LED 4

string mensagem;

void setup()
{
  Serial.begin(9600);
  Serial2.begin(9600, SERIAL_8N1, RXp2, TXp2);
  pinMode(LED, OUTPUT);
}
void loop()
{
  mensagem = Serial2.readString();
  Serial.println(mensagem);
  if(mensagem = "1")
    digitalWrite(LED, HIGH);

  delay(tempo);
  digitalWrite(LED,LOW);
  delay(tempo);
}
